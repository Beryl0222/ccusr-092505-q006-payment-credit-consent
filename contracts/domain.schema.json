{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "支付与信贷同意账本领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ORDER_OPENED",
        "OFFER_SHOWN",
        "OFFER_UPDATED",
        "SUITABILITY_REVIEWED",
        "MANUAL_REVIEW_QUEUED",
        "MANUAL_REVIEW_RESOLVED",
        "ITEM_CONFIRMED",
        "PAYMENT_CONFIRMED",
        "CREDIT_ACCEPTED",
        "CREDIT_DECLINED",
        "CONTRACT_ISSUED",
        "CONSENT_REVOKED",
        "EARLY_SETTLED",
        "STATEMENT_GENERATED",
        "DISPUTE_OPENED",
        "DISPUTE_STAGE_ADVANCED",
        "DISPUTE_RESOLVED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "payment_order",
        "credit_offer",
        "consent_record",
        "suitability_assessment",
        "credit_contract",
        "dispute_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
